{
  "name": "river-mind-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "npm run build && npm start",
    "dev": "concurrently -k -n server,client -c cyan,green \"tsx watch server/index.ts\" \"vite --config vite.config.ts\"",
    "build": "vite build --config vite.config.ts && tsup server/index.ts --format esm --out-dir dist/server --sourcemap --clean",
    "start": "node dist/server/index.js",
    "service:install": "bash scripts/macos-service.sh install",
    "service:start": "bash scripts/macos-service.sh start",
    "service:stop": "bash scripts/macos-service.sh stop",
    "service:restart": "bash scripts/macos-service.sh restart",
    "service:status": "bash scripts/macos-service.sh status",
    "service:logs": "bash scripts/macos-service.sh logs",
    "service:uninstall": "bash scripts/macos-service.sh uninstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate:adaptive": "node --import tsx scripts/simulate-adaptive.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^5.20.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
